# Optional — the site runs fine with zero env vars.
# PORT=3000
# DATABASE_PATH=/var/data/vyrx-library.db   # local data file path (fallback mode)
#
# Hosted database (Turso / libSQL) — RECOMMENDED for production. When both
# variables are set, all data (accounts, videos, settings) lives in the hosted
# database and survives redeploys/restarts. When either is unset, the app
# falls back to the local DATABASE_PATH file above.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
#
# Google sign-in ("Continue with Google") — optional. Create an OAuth 2.0
# "Web application" client in Google Cloud Console and whitelist this
# authorized redirect URI:  https://YOUR-DOMAIN/auth/google/callback
# (for local testing also add: http://localhost:3000/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
